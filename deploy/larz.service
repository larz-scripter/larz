# systemd unit — /etc/systemd/system/larz.service
[Unit]
Description=Larz app
After=network.target

[Service]
WorkingDirectory=/srv/myapp
Environment=LARZ_ENV=production
Environment=PORT=8000
ExecStart=/usr/local/bin/gunicorn -c deploy/gunicorn.conf.py app:app
Restart=always
RestartSec=3
User=www-data

[Install]
WantedBy=multi-user.target
